+void AFoundryRobot::EmitImpactPiece(EImpactPiece Kind, const FVector& Location, const FVector& Velocity, const FVector& Acceleration,
+    const FVector& SizeCm, const FQuat& Rotation, const FVector& Spin, const FLinearColor& Color,
+    float Lifetime, float Delay, float Glow, float Growth)
+{
+    if (ImpactMaterials.Num() != ImpactPoolSize) return;
+    int32 Slot = NextImpactSlot;
+    for (int32 Offset = 0; Offset < ImpactPoolSize; ++Offset)
+    {
+        const int32 Candidate = (NextImpactSlot + Offset) % ImpactPoolSize;
+        if (!ImpactParticles[Candidate].bActive) { Slot = Candidate; break; }
+    }
+    // Saturation deterministically replaces one old cue; it never queues more
+    // particles, actors, gameplay events, collision or RNG requests.
+    NextImpactSlot = (Slot + 1) % ImpactPoolSize;
+    FImpactParticle& Piece = ImpactParticles[Slot];
+    Piece = FImpactParticle();
+    Piece.bActive = true;
+    Piece.Kind = Kind;
+    Piece.Origin = Location;
+    Piece.Velocity = Velocity;
+    Piece.Acceleration = Acceleration;
+    Piece.SizeCm = SizeCm;
+    Piece.Rotation = Rotation;
+    Piece.Spin = Spin;
+    Piece.Lifetime = Lifetime;
+    Piece.Age = -Delay;
+    Piece.Glow = Glow;
+    Piece.Growth = Growth;
+    ImpactFrame(Piece.Anchor, Piece.AnchorRotation);
+    UStaticMeshComponent* Component = ImpactMeshes[Slot];
+    Component->SetStaticMesh(Kind == EImpactPiece::Smoke ? ImpactSphere : ImpactCube);
+    Component->SetWorldLocationAndRotation(Location, Rotation);
+    Component->SetWorldScale3D(SizeCm / 100);
+    Component->SetVisibility(Delay <= 0);
+    UMaterialInstanceDynamic* Material = ImpactMaterials[Slot];
+    Material->SetVectorParameterValue(TEXT("FlatColor"), Color);
+    Material->SetVectorParameterValue(TEXT("EmissiveColor"), Kind == EImpactPiece::Smoke ? FLinearColor::Black : Color);
+    Material->SetScalarParameterValue(TEXT("Metallic"), Kind == EImpactPiece::Fragment ? .85f : 0.f);
+    Material->SetScalarParameterValue(TEXT("Roughness"), Kind == EImpactPiece::Smoke ? 1.f : .32f);
+    Material->SetScalarParameterValue(TEXT("Dissolve"), Kind == EImpactPiece::Smoke ? .52f : 0.f);
+    Material->SetScalarParameterValue(TEXT("Glow"), Glow);
+}
+
+void AFoundryRobot::EmitImpact(EImpactResponse Response, uint64 EventId, float Delay)
+{
+    const bool bDeath = Response == EImpactResponse::Death;
+    if (bDeath)
+    {
+        if (bDeathBurstShown) return;
+        ResetImpactEffects();
+        bDeathBurstShown = true;
+    }
+    const bool bDeflect = Response == EImpactResponse::Deflect, bShield = Response == EImpactResponse::Shield;
+    const bool bCollapse = Response == EImpactResponse::Collapse, bHeavy = Response == EImpactResponse::Heavy;
+    const float Scale = ImpactSizeScale;
+    FVector Anchor;
+    FQuat Frame;
+    ImpactFrame(Anchor, Frame);
+    FVector Normal = Frame.RotateVector(ImpactNormal).GetSafeNormal();
+    if (bCollapse) { Anchor.Z = GetActorLocation().Z + 5; Normal = FVector::UpVector; }
+    FVector Across, Up;
+    Normal.FindBestAxisVectors(Across, Up);
+    const uint32 Seed = static_cast<uint32>(CoreId) ^ static_cast<uint32>(CoreId >> 32) ^
+        (static_cast<uint32>(EventId) * 196314165u) ^ static_cast<uint32>(EventId >> 32) ^ (static_cast<uint32>(Response) * 907633515u);
+    FRandomStream Random(static_cast<int32>(Seed)); // Separate, local cosmetic stream only.
+    const FLinearColor White(1.f, .95f, .83f), Blue(.025f, .38f, 1.f), Warm(1.f, .26f, .025f);
+    const FLinearColor Color = bDeflect ? White : (bShield ? Blue : Warm);
+    const FVector Zero = FVector::ZeroVector;
+    if (bShield)
+    {
+        // A small segmented absorption arc on the struck surface, never a
+        // full-body sphere. Radial motion and quick erosion show energy spent.
+        for (int32 Index = 0; Index < 8; ++Index)
+        {
+            const float Angle = (Index + .5f) * PI / 4;
+            const FVector Radial = Across * FMath::Cos(Angle) + Up * FMath::Sin(Angle);
+            const FVector Tangent = -Across * FMath::Sin(Angle) + Up * FMath::Cos(Angle);
+            EmitImpactPiece(EImpactPiece::Arc, Anchor + Radial * (18 * Scale), Radial * (42 * Scale), Zero,
+                FVector(10, 1.4, 1.4) * Scale, Tangent.Rotation().Quaternion(), Zero, Blue, .24f, Delay, 5);
+        }
+    }
+    if (!bCollapse)
+    {
+        const float Length = bDeath ? 28.f : (bHeavy ? 19.f : 12.f);
+        for (const FVector& Axis : {Across, Up})
+            EmitImpactPiece(EImpactPiece::Contact, Anchor, Zero, Zero, FVector(Length, 1.8, 1.8) * Scale,
+                Axis.Rotation().Quaternion(), Zero, bShield ? Blue : White, bDeath ? .12f : .075f, Delay, bDeath ? 10.f : 7.f);
+    }
+    const int32 Sparks = bShield || bCollapse ? 0 : (bDeflect ? 4 : (bDeath ? 11 : (bHeavy ? 8 : (Response == EImpactResponse::Medium ? 6 : 4))));
+    for (int32 Index = 0; Index < Sparks; ++Index)
+    {
+        const float Angle = Random.FRandRange(0, 2 * PI);
+        const FVector Radial = Across * FMath::Cos(Angle) + Up * FMath::Sin(Angle);
+        const FVector Direction = (Normal * Random.FRandRange(.65f, 1.25f) + Radial * Random.FRandRange(.35f, 1.f)).GetSafeNormal();
+        const FVector Velocity = Direction * Random.FRandRange(bDeflect ? 110.f : 170.f, bDeath ? 340.f : 260.f) * Scale;
+        EmitImpactPiece(EImpactPiece::Spark, Anchor + Normal * (2 * Scale), Velocity, FVector(0, 0, -260 * Scale),
+            FVector(Random.FRandRange(9, bDeath ? 22.f : 16.f), .7, .7) * Scale, Direction.Rotation().Quaternion(), Zero,
+            Color, Random.FRandRange(bDeflect ? .08f : .16f, bDeflect ? .14f : .30f), Delay, bDeflect ? 6.f : 8.f);
+    }
+    const int32 Fragments = bDeflect || bShield ? 0 : (bDeath ? 5 : (bCollapse ? 2 : (bHeavy ? 3 : (Response == EImpactResponse::Medium ? 2 : 1))));
+    for (int32 Index = 0; Index < Fragments; ++Index)
+    {
+        const FVector Velocity = (Normal * Random.FRandRange(60, 130) + Across * Random.FRandRange(-75, 75) + FVector(0, 0, Random.FRandRange(45, 125))) * Scale;
+        const FQuat SpinStart = FRotator(Random.FRandRange(0, 360), Random.FRandRange(0, 360), Random.FRandRange(0, 360)).Quaternion();
+        EmitImpactPiece(EImpactPiece::Fragment, Anchor, Velocity, FVector(0, 0, -520 * Scale),
+            FVector(Random.FRandRange(2.5f, 4.5f), Random.FRandRange(1.2f, 2.4f), .6) * Scale, SpinStart,
+            FVector(Random.FRandRange(-5, 5), Random.FRandRange(-5, 5), Random.FRandRange(-5, 5)),
+            FLinearColor(.22f, .25f, .28f), bDeath ? .66f : .46f, Delay, .35f);
+    }
+    const int32 Smoke = bDeath ? 3 : (bCollapse ? 3 : (bHeavy ? 2 : 0));
+    for (int32 Index = 0; Index < Smoke; ++Index)
+    {
+        const FVector Position = Anchor + Across * Random.FRandRange(-10, 10) * Scale;
+        EmitImpactPiece(EImpactPiece::Smoke, Position,
+            (Normal * Random.FRandRange(10, 25) + FVector(0, 0, Random.FRandRange(28, 45))) * Scale, Zero,
+            FVector(Random.FRandRange(10, 15), Random.FRandRange(9, 14), Random.FRandRange(12, 18)) * Scale,
+            FQuat::Identity, Zero, FLinearColor(.11f, .12f, .13f), bDeath ? .70f : .46f,
+            Delay + .045f * Index, 0, 1.2f);
+    }
+    if (!bCollapse)
+    {
+        ImpactLight->SetWorldLocation(Anchor + Normal * (9 * Scale));
+        ImpactLight->SetLightColor(Color);
+        ImpactLightDuration = bDeath ? .18f : (bShield ? .13f : .09f);
+        ImpactLightRemaining = ImpactLightDuration;
+        ImpactLightPeak = (bDeath ? 11000.f : 4800.f) * Scale;
+        ImpactLight->SetIntensity(ImpactLightPeak);
+    }
+    const TCHAR* Label = bDeath ? TEXT("death") : (bDeflect ? TEXT("deflect_white") : (bShield ? TEXT("shield_blue") :
+        (bCollapse ? TEXT("collapse") : (bHeavy ? TEXT("hp_heavy") : (Response == EImpactResponse::Medium ? TEXT("hp_medium") : TEXT("hp_light")))));
+    UE_LOG(LogFoundryRobot, Display, TEXT("ART_IMPACT id=%llu event=%llu kind=%s active=%d capacity=%d scale=%.3f contact=%s sparks=%d fragments=%d smoke=%d cosmetic_only=1"),
+        CoreId, EventId, Label, GetActiveImpactFxCount(), ImpactPoolSize, Scale, *Anchor.ToString(), Sparks, Fragments, Smoke);
+}
