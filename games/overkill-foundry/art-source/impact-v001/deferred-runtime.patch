+void AFoundryRobot::InitializeImpactEffects(const FVector& ImportedSize, UMaterialInterface* Material)
+{
+    check(Material);
+    ImpactCube = LoadObject<UStaticMesh>(nullptr, TEXT("/Engine/BasicShapes/Cube.Cube"));
+    ImpactSphere = LoadObject<UStaticMesh>(nullptr, TEXT("/Engine/BasicShapes/Sphere.Sphere"));
+    check(ImpactCube && ImpactSphere);
+    ImpactSizeScale = FMath::Clamp(static_cast<float>(ImportedSize.Z / 240), .55f, 1.5f);
+    bool bMounted = false;
+    for (const FImpactMount& Mount : ImpactMounts) if (Definition == Mount.Definition)
+    {
+        ImpactOffset = Mount.Offset;
+        ImpactNormal = Mount.Normal;
+        bMounted = true;
+        break;
+    }
+    checkf(bMounted, TEXT("Missing original impact mount for %s"), *Definition);
+    const FReferenceSkeleton& Skeleton = Body->GetSkeletalMeshAsset()->GetRefSkeleton();
+    int32 Bone = Skeleton.FindBoneIndex(TEXT("core"));
+    check(Bone != INDEX_NONE);
+    FTransform Reference = Skeleton.GetRefBonePose()[Bone];
+    while ((Bone = Skeleton.GetParentIndex(Bone)) != INDEX_NONE) Reference = Reference * Skeleton.GetRefBonePose()[Bone];
+    ImpactReferenceInverse = Reference.GetRotation().Inverse();
+    if (ImpactMaterials.IsEmpty()) for (UStaticMeshComponent* Piece : ImpactMeshes)
+    {
+        UMaterialInstanceDynamic* Instance = UMaterialInstanceDynamic::Create(Material, this);
+        Instance->SetScalarParameterValue(TEXT("UseTexture"), 0);
+        Instance->SetScalarParameterValue(TEXT("NormalStrength"), 0);
+        Piece->SetStaticMesh(ImpactCube);
+        Piece->SetMaterial(0, Instance);
+        ImpactMaterials.Add(Instance);
+    }
+    ImpactLight->SetAttenuationRadius(115 * ImpactSizeScale);
+    ResetImpactEffects();
+    UE_LOG(LogFoundryRobot, Display, TEXT("ART_IMPACT_INIT id=%llu capacity=%d scale=%.3f core_surface_offset=%s cosmetic_only=1"),
+        CoreId, ImpactMeshes.Num(), ImpactSizeScale, *ImpactOffset.ToString());
+}
+
+void AFoundryRobot::ImpactFrame(FVector& Location, FQuat& Rotation) const
+{
+    const FTransform Core = Body->GetSocketTransform(TEXT("core"));
+    Rotation = Core.GetRotation() * ImpactReferenceInverse;
+    Location = Core.GetLocation() + Rotation.RotateVector(ImpactOffset * Body->GetComponentScale());
+}
+
+int32 AFoundryRobot::GetActiveImpactFxCount() const
+{
+    int32 Count = 0;
+    for (const FImpactParticle& Piece : ImpactParticles) if (Piece.bActive) ++Count;
+    return Count;
+}
+
+void AFoundryRobot::ResetImpactEffects()
+{
+    for (int32 Index = 0; Index < ImpactParticles.Num(); ++Index)
+    {
+        ImpactParticles[Index] = FImpactParticle();
+        ImpactMeshes[Index]->SetVisibility(false);
+        ImpactMeshes[Index]->SetWorldScale3D(FVector(.001));
+        if (ImpactMaterials.IsValidIndex(Index))
+        {
+            ImpactMaterials[Index]->SetScalarParameterValue(TEXT("Dissolve"), 1);
+            ImpactMaterials[Index]->SetScalarParameterValue(TEXT("Glow"), 0);
+        }
+    }
+    NextImpactSlot = 0;
+    bDeathBurstShown = false;
+    ImpactLightRemaining = ImpactLightDuration = ImpactLightPeak = 0;
+    ImpactLight->SetIntensity(0);
+}
+
+void AFoundryRobot::EndPlay(const EEndPlayReason::Type EndPlayReason)
+{
+    const int32 Active = GetActiveImpactFxCount();
+    ResetImpactEffects();
+    UE_LOG(LogFoundryRobot, Display, TEXT("ART_IMPACT_CLEANUP id=%llu cleared=%d active=0 owned_components=%d reason=%d"),
+        CoreId, Active, ImpactMeshes.Num(), static_cast<int32>(EndPlayReason));
+    Super::EndPlay(EndPlayReason);
+}
