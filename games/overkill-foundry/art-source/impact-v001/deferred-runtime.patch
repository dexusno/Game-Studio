+void AFoundryRobot::TickImpactEffects(float DeltaSeconds)
+{
+    FVector Anchor;
+    FQuat Frame;
+    ImpactFrame(Anchor, Frame);
+    for (int32 Index = 0; Index < ImpactParticles.Num(); ++Index)
+    {
+        FImpactParticle& Piece = ImpactParticles[Index];
+        if (!Piece.bActive) continue;
+        Piece.Age += FMath::Max(0.f, DeltaSeconds);
+        UStaticMeshComponent* Component = ImpactMeshes[Index];
+        if (Piece.Age >= Piece.Lifetime)
+        {
+            Piece.bActive = false;
+            Component->SetVisibility(false);
+            ImpactMaterials[Index]->SetScalarParameterValue(TEXT("Glow"), 0);
+            ImpactMaterials[Index]->SetScalarParameterValue(TEXT("Dissolve"), 1);
+            continue;
+        }
+        if (Piece.Age < 0) continue;
+        Component->SetVisibility(true);
+        const float Progress = Piece.Age / Piece.Lifetime;
+        FVector Location = Piece.Origin + Piece.Velocity * Piece.Age + Piece.Acceleration * (.5f * Piece.Age * Piece.Age);
+        FQuat Rotation = Piece.Rotation;
+        if (Piece.Kind == EImpactPiece::Arc || Piece.Kind == EImpactPiece::Contact)
+        {
+            const FQuat Follow = Frame * Piece.AnchorRotation.Inverse();
+            Location = Anchor + Follow.RotateVector(Location - Piece.Anchor);
+            Rotation = Follow * Rotation;
+        }
+        else if (Piece.Kind == EImpactPiece::Spark) Rotation = (Piece.Velocity + Piece.Acceleration * Piece.Age).Rotation().Quaternion();
+        else if (Piece.Kind == EImpactPiece::Fragment && !Piece.Spin.IsNearlyZero())
+            Rotation = FQuat(Piece.Spin.GetSafeNormal(), Piece.Spin.Size() * Piece.Age) * Rotation;
+        FVector Size = Piece.SizeCm;
+        if (Piece.Kind == EImpactPiece::Smoke) Size *= 1 + Piece.Growth * Progress;
+        else if (Piece.Kind == EImpactPiece::Spark) Size.X *= 1 - .7f * Progress;
+        const float Fade = Piece.Kind == EImpactPiece::Smoke ? .52f + .48f * Progress : FMath::Clamp((Progress - .25f) / .75f, 0.f, 1.f);
+        Component->SetWorldLocationAndRotation(Location, Rotation);
+        Component->SetWorldScale3D(Size / 100);
+        ImpactMaterials[Index]->SetScalarParameterValue(TEXT("Dissolve"), Fade);
+        ImpactMaterials[Index]->SetScalarParameterValue(TEXT("Glow"), Piece.Glow * FMath::Square(1 - Progress));
+    }
+    if (ImpactLightRemaining > 0)
+    {
+        ImpactLightRemaining = FMath::Max(0.f, ImpactLightRemaining - DeltaSeconds);
+        ImpactLight->SetIntensity(ImpactLightPeak * FMath::Square(ImpactLightRemaining / ImpactLightDuration));
+    }
+}
