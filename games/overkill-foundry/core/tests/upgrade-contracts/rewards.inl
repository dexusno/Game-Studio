add("UGS-125","third actual Officer victory awakens future entries only, no reacquisition, first haul and shot once",[]{auto c=campaign();buy(c,ProductKind::Upgrade,"UGS-125");Amount officers=0;bool observed=false;for(int n=0;n<12;++n){enterAvailable(c,true);const auto kind=c.fight.encounterClass;const auto awake=officers>=3;const auto bonus=std::accumulate(c.fight.shotBonuses.begin(),c.fight.shotBonuses.end(),Amount{},[](Amount n,const ShotBonus& b){return n+b.flat;});check(bonus==(awake?7:0),"No combat effect before third Officer, no retroactive bonus in that fight");const auto before=c.fight.materials;combat(c,Action::collect(0));check(c.fight.materials[0]-before[0]==(awake?6:5),"First haul only gets1steered after awakening");if(awake){observed=true;c.fight.hotBarrel=false;for(auto& e:c.fight.enemies){e.armor=e.shield=e.tiles=e.mesh=0;e.hp=e.maxHp=10000;}const auto target=c.fight.enemies[0].id;check(shot(c.fight,"SH001",target)==13&&shot(c.fight,"SH001",target)==6,"First valid main gains7 only");}finish(c);if(kind==EncounterClass::Officer)++officers;check(upgradeCounter(*ownedUpgrade(c.fight,"UGS-125"),"awakened")== (officers>=3?1:0),"Third Officer autoawakens same owned ledger");leave(c);}check(officers==3&&observed,"Actual future entry after third Officer exercised");check(std::count(c.everAcquired.begin(),c.everAcquired.end(),"UGS-125")==1,"Awakening not second collectible");});
