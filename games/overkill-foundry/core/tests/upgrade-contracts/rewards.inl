void rewardCases(){
add("UGS-031","normal offer fourth Shared option retains encounter pool and one pick; bonus offers unchanged",[]{auto c=campaign();buy(c,ProductKind::Upgrade,"UGS-031");buy(c,ProductKind::Upgrade,"UGS-101");buy(c,ProductKind::Upgrade,"UGS-147");bool officer=false;for(int n=0;n<12;++n){enterAvailable(c,true);const auto kind=c.fight.encounterClass;finish(c);for(const auto& r:c.rewards)if(r.kind==RewardKind::Recipe){check(r.choices.size()==(r.normalOffer?4u:3u),"Only normal offers gain fourth");if(r.normalOffer)check(r.choices.back().substr(0,2)=="SH","Extra candidate is Shared");}if(kind==EncounterClass::Officer){check(recipeRewards(c,false)==1,"Separate Officer Rare offer unchanged");officer=true;}const auto first=reward(c).id;const auto candidate=reward(c).choices.front();acceptRecipe(c,candidate);reject(c,command(c,CampaignActionType::ClaimReward,first,candidate));leave(c);if(officer)break;}check(officer,"Test reached real Officer");});
add("UGS-034","third true victory adds one Shared Utility, counter persists through real transitions and one pick",[]{auto c=campaign();buy(c,ProductKind::Upgrade,"UGS-034");for(int win=1;win<=6;++win){enter(c);finish(c);auto& r=reward(c);check(r.choices.size()==(win%3==0?4u:3u),"Every third actual victory only");if(win%3==0){const auto id=r.choices.back();check(id.substr(0,2)=="SH"&&fights.recipe(id)->kind==Kind::Utility,"Extra is Shared Utility");const auto rewardId=r.id;acceptRecipe(c,id);reject(c,command(c,CampaignActionType::ClaimReward,rewardId,id));}if(win==2)controlledCityBoundary(c);snapshot(c);leave(c);}check(upgradeCounter(*ownedUpgrade(c.fight,"UGS-034"),"victories")==6,"Campaign counter retained through clearFight");});
add("UGS-062","every second victory adds Shared Modifier including spread category; whole offer still one pick",[]{auto c=campaign();buy(c,ProductKind::Upgrade,"UGS-062");for(int win=1;win<=4;++win){enter(c);finish(c);auto& r=reward(c);check(r.choices.size()==(win%2==0?4u:3u),"Every second actual victory");if(win%2==0){const auto id=r.choices.back();const auto kind=fights.recipe(id)->kind;check(id.substr(0,2)=="SH"&&(kind==Kind::Modifier||kind==Kind::Spread),"Shared source Modifier category");const auto rewardId=r.id;acceptRecipe(c,id);reject(c,command(c,CampaignActionType::ClaimReward,rewardId,id));}if(win==1)controlledCityBoundary(c);snapshot(c);leave(c);}check(upgradeCounter(*ownedUpgrade(c.fight,"UGS-062"),"victories")==4,"Counter persists across ordinary fight cleanup");
    // Controlled content pool isolates the adapter's category predicate. It
    // preserves actual acquisition/victory/offer machinery; it is not a claim
    // about the probability of SH051 in the production weighted pool.
    auto content=cinderwallContent();for(auto& pool:content.recipePools)if(pool.name=="Regular"){pool.ids={"SH041","SH042","SH044","SH045","SH051"};pool.weights={0,0,1,0,0};}
    CampaignRules constrained(fights,cinderwallUpgradeHooks(fights,content),content);bool witnessed=false;
    for(std::uint64_t seed=1;seed<=24&&!witnessed;++seed){auto state=constrained.newGame(seed,"modifier-pool-"+std::to_string(seed));state.mayorOffers={"MY1-02","MY1-03","MY1-01"};auto apply=[&](CampaignAction action){const auto result=constrained.apply(state,action);check(result.ok,result.reason);};apply(command(state,CampaignActionType::ChooseMayor,0,"MY1-02"));state.fight.credits=500;const auto product=state.nextId++;state.shop.push_back({product,ProductKind::Upgrade,"UGS-062",0,1,10});apply(command(state,CampaignActionType::Buy,product));
        for(int win=0;win<2;++win){const auto offers=routeOffers(state.route);const auto selected=std::find_if(offers.begin(),offers.end(),[](const RouteOffer& o){return o.kind==EncounterKind::Regular;});check(selected!=offers.end(),"Controlled route Regular exists");apply(command(state,CampaignActionType::EnterOffer,selected->id));auto action=command(state,CampaignActionType::Combat);action.combat=Action::collect(0);apply(action);while(state.phase==CityPhase::Fight){Id target=0;for(const auto& e:state.fight.enemies)if(!e.dead&&!e.escaped){target=e.id;break;}const auto ammo=plain(state.fight,Kind::Ammo,500);action=command(state,CampaignActionType::Combat);action.combat=Action::load({ammo});apply(action);action=command(state,CampaignActionType::Combat);action.combat=Action::fire(target);apply(action);}if(win==0){apply(command(state,CampaignActionType::RequestAdvance));apply(command(state,CampaignActionType::ConfirmAdvance));}}
        const auto& choices=reward(state).choices;if(choices.size()==4){check(choices.back()=="SH051","Only source Modifier candidate is spreading SH051");witnessed=true;}}
    check(witnessed,"At least one actual second-victory adapter offer includes previously excluded spread category");});
add("UGS-101","Regular victories expose two independent optional offers; Officer and Boss have no addition",[]{auto c=campaign();buy(c,ProductKind::Upgrade,"UGS-101");bool officer=false,boss=false;for(int position=1;position<=12;++position){enterAvailable(c,true);const auto kind=c.fight.encounterClass;finish(c);check(recipeRewards(c)==(kind==EncounterClass::Regular?2u:1u),"Only Regular rewards get second normal offer");if(position==1){controlledRecipes(c,{"SH001","SH002","SH003"});const auto firstId=reward(c).id;acceptRecipe(c,"SH001");reject(c,command(c,CampaignActionType::ClaimReward,firstId,"SH001"));c.memorySlots=static_cast<Amount>(c.fight.memory.size());controlledRecipes(c,{"SH002","SH001","SH003"});check(acceptRecipe(c,"SH002")==0&&c.pendingRecipeChoice=="SH002","Second independent offer uses normal saved exchange");snapshot(c);const auto secondId=reward(c).id;auto action=command(c,CampaignActionType::ClaimReward,secondId,"SH002");action.exchange=c.fight.memory[0].id;run(c,action);check(recipeRewards(c)==2,"Accept one from each without combining pools");}if(kind==EncounterClass::Officer)officer=true;if(kind==EncounterClass::Boss)boss=true;leave(c);}check(officer&&boss&&c.phase==CityPhase::Complete,"Complete source route tested both exclusions; skipping offers remains legal");});
add("UGS-147","Officer alone adds separate three Rare choices without extra upgrade reward and normal exchange",[]{auto c=campaign();buy(c,ProductKind::Upgrade,"UGS-147");bool accepted=false;for(int n=0;n<12;++n){enterAvailable(c,true);const auto kind=c.fight.encounterClass;finish(c);check(recipeRewards(c,false)==(kind==EncounterClass::Officer?1u:0u),"Officer-only separate offer");const auto upgrades=std::count_if(c.rewards.begin(),c.rewards.end(),[](const RewardEntry& r){return r.kind==RewardKind::Upgrade||r.kind==RewardKind::Credits;});check(upgrades==(kind==EncounterClass::Officer?1:0),"Exactly existing one Officer permanent upgrade reward, none added");if(kind==EncounterClass::Officer&&!accepted){auto& r=reward(c,RewardKind::Recipe,false);check(r.choices.size()==3&&r.fixedRarity==3,"Three saved Rare candidates");for(const auto& id:r.choices)check(fights.recipe(id)->rarity==Rarity::Rare,"Every separate candidate Rare");const auto id=r.id;const auto selected=r.choices[0];c.memorySlots=static_cast<Amount>(c.fight.memory.size());check(acceptRecipe(c,selected,0,id)==0,"Full memory pauses ordinary exchange");auto action=command(c,CampaignActionType::ClaimReward,id,selected);action.exchange=c.fight.memory[0].id;run(c,action);reject(c,command(c,CampaignActionType::ClaimReward,id,selected));accepted=true;}leave(c);}check(accepted&&c.phase==CityPhase::Complete,"Regular, Officer and Boss paths executed");});
add("MY1-13","every third Regular victory earns exact-copy subscription, excludes duplicate tags and defers empty sets",[]{auto c=campaign("MY1-13");int regular=0;Id tagged=0;bool officer=false;for(int n=0;n<12&&regular<6;++n){enterAvailable(c,true);const auto kind=c.fight.encounterClass;finish(c);if(kind==EncounterClass::Regular)++regular;else if(kind==EncounterClass::Officer)officer=true;if(kind==EncounterClass::Regular&&regular%3==0){check(c.upgradeOffers.size()==1&&c.upgradeOffers[0].kind==UpgradeRequestKind::Subscription,"Third Regular earns one saved selection");auto action=command(c,CampaignActionType::ResolveUpgradeOffer,c.upgradeOffers[0].id);action.target=c.upgradeOffers[0].copies[0];if(!tagged)for(Id candidate:c.upgradeOffers[0].copies)if(copy(c.fight,candidate).recipe=="SH001")action.target=candidate;action.material=0;if(tagged)check(std::find(c.upgradeOffers[0].copies.begin(),c.upgradeOffers[0].copies.end(),tagged)==c.upgradeOffers[0].copies.end(),"Each physical copy subscribes once");else tagged=action.target;snapshot(c);run(c,action);check(!copy(c.fight,action.target).tags.empty(),"Exact permanent copy tagged");}else check(c.upgradeOffers.empty(),"No Officer/early Regular entitlement");leave(c);}check(regular==6&&officer&&tagged,"Two complete Regular subscription cycles with Officer exclusion");enterAvailable(c,false);combat(c,Action::collect(0));c.fight.materials={20,20,20,20,20};const auto before=c.fight.materials;craft(c.fight,tagged);check(c.fight.materials[0]==before[0],"Chosen SH001 copy saves1Iron first Use");next(c.fight);const auto b=c.fight.materials;craft(c.fight,tagged);check(c.fight.materials[0]==b[0]-1,"No per-turn renewal");
    auto deferred=campaign("MY1-13");deferred.fight.memory.clear();for(int i=0;i<3;++i){enter(deferred);finish(deferred);if(i<2)leave(deferred);}check(deferred.upgradeOffers.size()==1&&deferred.upgradeOffers[0].deferred&&deferred.fight.upgradeRequests.empty(),"Earned selection defers without blocking when no eligible copy");leave(deferred);buy(deferred,ProductKind::Recipe,"SH001");check(deferred.upgradeOffers.size()==1&&!deferred.upgradeOffers[0].deferred,"Later acquisition reopens preserved entitlement");auto action=command(deferred,CampaignActionType::ResolveUpgradeOffer,deferred.upgradeOffers[0].id);action.target=deferred.upgradeOffers[0].copies[0];action.material=0;run(deferred,action);});
add("UGS-045","actual Officer wins after acquisition build capped levels and future first shot consumes bonus once",[]{auto c=campaign();buy(c,ProductKind::Upgrade,"UGS-045");Amount officers=0;for(int n=0;n<12;++n){enterAvailable(c,true);const auto kind=c.fight.encounterClass;const auto expected=2*std::min(3,officers);check(std::accumulate(c.fight.shotBonuses.begin(),c.fight.shotBonuses.end(),Amount{},[](Amount n,const ShotBonus& b){return n+b.flat;})==expected,"Opening bonus reflects only previously earned levels");finish(c);if(kind==EncounterClass::Officer)++officers;check(ownedUpgrade(c.fight,"UGS-045")->campaignCount==std::min(3,officers),"Regular/Boss do not grant levels");leave(c);}check(officers==3,"All three actual city Officers taken");
    // A repeated post-city controlled Officer fight checks the future-city cap
