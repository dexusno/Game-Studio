void entryTurnCases(){
add("MY1-03","entry pair has independent physical identities and normal saved/installed lifetime",[]{auto s=arena();acquire(s,"MY1-03");const auto mem=s.memory.size();start(s);auto ids=outputs(s,"MY1-03");check(ids.size()==2&&ids[0]!=ids[1]&&s.memory.size()==mem,"Fresh pair must not grant recipe ownership");check(part(s,ids[0]).kind==Kind::Ammo&&part(s,ids[0]).originalValue==6&&part(s,ids[0]).place==Place::Reserve,"Plain Ammo6 reserve");check(part(s,ids[1]).kind==Kind::Shield&&Rules::shield(s)==6&&part(s,ids[1]).origin==PartOrigin::Granted,"Granted installed Shield6");collect(s);act(s,Action::remove(ids[1]));snapshot(s);next(s);check(exists(s,ids[0])&&exists(s,ids[1]),"Untouched pair can be saved");act(s,Action::install(ids[1]));fire(s,{ids[0]});check(s.enemies[0].hp==9994,"Saved granted Ammo deals6");end(s);check(!exists(s,ids[0])&&!exists(s,ids[1]),"Used Ammo and installed Shield clean up");s=renewed(s);start(s);check(outputs(s,"MY1-03").size()==2,"Fresh pair every entry");});
add("MY1-04","opening material extra is separate from collection and repeats only at entry",[]{auto s=arena();acquire(s,"MY1-04");const auto before=s.materials;start(s);check(delta(s.materials,before)==Materials({3,3,0,0,0}),"Entry extra3Iron3Copper");collect(s,-1,4);check(delta(s.materials,before)==Materials({6,5,1,1,3}),"Ordinary composition/steering unchanged");const auto held=s.materials;end(s);check(s.materials==held,"No turn2 extra");s=renewed(s);const auto b=s.materials;start(s);check(delta(s.materials,b)==Materials({3,3,0,0,0}),"Entry resets opening extra");});
add("MY1-07","Officer entry alone grants four Iron and removable Shield8",[]{for(auto kind:{EncounterClass::Regular,EncounterClass::Officer,EncounterClass::Boss}){auto s=arena();acquire(s,"MY1-07");start(s,kind);const bool eligible=kind==EncounterClass::Officer;check(s.materials[0]==100+(eligible?4:0)&&Rules::shield(s)==(eligible?8:0),"Officer filter");collect(s);if(eligible){const auto id=outputs(s,"MY1-07").front();check(part(s,id).origin==PartOrigin::Granted,"Physical grant");act(s,Action::remove(id));next(s);check(exists(s,id)&&Rules::shield(s)==0,"Untouched Officer Shield is saveable");}else next(s);check(s.materials[0]==110+(eligible?4:0),"No repeated turn grant");}});
add("MY3-02","six active opening Shield protects preparation and enemy damage then resets",[]{auto s=arena();acquire(s,"MY3-02");start(s);check(Rules::shield(s)==6&&s.parts.empty(),"Direct balance not a physical part");collect(s);s.enemies[0].mesh=2;shot(s);check(s.hp==40&&Rules::shield(s)==4,"Preparation recoil uses opening active Shield");attacks(s,2);end(s);check(s.hp==38&&Rules::shield(s)==0,"Enemy hits consume remaining4; no renewal turn2");s=renewed(s);start(s);check(Rules::shield(s)==6,"Every fight opening balance");});
add("UGS-006","highest maximum HP opening Paint uses stable slot tie and ignores dead/escaped",[]{for(int variant=0;variant<3;++variant){auto s=arena();acquire(s,"UGS-006");s.enemies[0].maxHp=20000;s.enemies[0].hp=1;s.enemies[1].maxHp=20000;s.enemies[2].maxHp=15000;if(variant==1)s.enemies[0].dead=true;if(variant==2)s.enemies[0].escaped=true;start(s);check(s.enemies[static_cast<std::size_t>(variant?1:0)].mark==2,"Uses maxHP, living eligibility and stable first tie");check(s.enemies[2].mark==0,"Lower maximum not selected");collect(s);const auto before=s.enemies;next(s);for(std::size_t i=0;i<before.size();++i)check(s.enemies[i].mark==before[i].mark,"No per-turn paint reapplication");}});
add("UGS-007","opening named Slug and Pellet grant no recipes and retain independent sale identities",[]{auto s=arena();acquire(s,"UGS-007");start(s);const auto ids=outputs(s,"UGS-007");check(ids.size()==2&&ids[0]!=ids[1]&&s.memory.empty(),"Two distinct physical grants, no memory");check(part(s,ids[0]).recipe=="SH001"&&part(s,ids[1]).recipe=="SH003"&&part(s,ids[0]).resaleReference=="SH001"&&part(s,ids[1]).resaleReference=="SH003","Named canonical recipe sale references");collect(s);next(s);check(exists(s,ids[0])&&exists(s,ids[1]),"Both unused grants saved");fire(s,ids);check(s.enemies[0].hp==9991&&s.parts.empty(),"Both ordinary Ammo consumed for9");s=renewed(s);start(s);check(outputs(s,"UGS-007").size()==2,"New pair next fight");});
add("UGS-013","entry heal clamps and production Continue restores original entry without accumulating",[]{auto c=campaign();buy(c,ProductKind::Upgrade,"UGS-013");c.fight.hp=40;enter(c);check(c.fight.hp==42,"Actual entry heals2");const auto entryHp=c.fight.hp;snapshot(c);combat(c,Action::collect(0));c.fight.hp=7;run(c,command(c,CampaignActionType::Continue));check(c.fight.hp==entryHp,"Continue restores original pre-entry then executes once");combat(c,Action::collect(0));c.fight.hp=1;run(c,command(c,CampaignActionType::Continue));check(c.fight.hp==entryHp,"Repeated Continue cannot stack entry healing");auto s=arena();acquire(s,"UGS-013");s.hp=79;start(s);check(s.hp==80,"Clamped to maximum");});
add("UGS-024","five saved entry choices consume one charge each and never recur after exhaustion",[]{auto s=arena();acquire(s,"UGS-024");for(int n=0;n<6;++n){if(n)s=renewed(s);start(s);check(s.upgradeChoices.size()==(n<5?1u:0u),"Exactly five opening choices");if(n<5){snapshot(s);const auto values=s.upgradeChoices.front().values;check(values==std::vector<Amount>({0,1,2}),"Only Iron/Copper/Carbon offered");Action invalid;invalid.type=ActionType::ResolveUpgradeChoice;invalid.upgradeChoice.choice=s.upgradeChoices.front().id;invalid.upgradeChoice.values={3};reject(s,invalid);selectMaterial(s,n%3);check(s.materials[static_cast<std::size_t>(n%3)]==102,"Chosen extra2");collect(s);next(s);check(s.upgradeChoices.empty(),"No second choice later this fight");}check(ownedUpgrade(s,"UGS-024")->charges==std::max(0,4-n),"Visible exact remaining charges");}});
add("UGS-037","opening four is separate direct damage with complete recoil and final-death interruption",[]{auto s=arena();acquire(s,"UGS-037");s.enemies[0].armor=7;s.enemies[0].shield=3;s.enemies[1].hp=3;s.enemies[2].tiles=1;const auto r=start(s);check(s.enemies[0].hp==10000&&s.enemies[0].shield==3,"Direct opening obeys Armor before Shield");check(s.enemies[1].dead&&s.enemies[2].tiles==0&&s.enemies[2].hp==9999,"Kills and reactive tile resolve normally");check(s.shots==0&&eventAmount(r,"shot")==0,"Not Fire");s=arena();acquire(s,"UGS-037");s.hp=2;s.enemies[0].mesh=2;start(s);check(s.phase==Phase::Defeat&&s.hp==0&&s.enemies[1].hp==10000,"Lethal recoil halts later opening targets");});
add("UGS-070","acquisition growth once and Boss-entry-only further growth",[]{auto s=arena();acquire(s,"UGS-070");check(s.maxHp==92&&s.hp==52,"Acquire12max and heal12");for(auto kind:{EncounterClass::Regular,EncounterClass::Officer,EncounterClass::Boss}){s=renewed(s);s.maxHp=92;s.hp=92;start(s,kind);check(s.maxHp==(kind==EncounterClass::Boss?93:92)&&s.hp==s.maxHp,"Only Boss entry grows1 and heals1");collect(s);next(s);check(s.maxHp==(kind==EncounterClass::Boss?93:92),"Not each Boss turn");}});
add("UGS-071","four acquisition HP then first enemy hit only reduces before Shield with zero floor",[]{for(Amount hit:{0,1,2}){auto s=arena();acquire(s,"UGS-071");check(s.maxHp==84&&s.hp==44,"Acquisition4");start(s);collect(s);plain(s,Kind::Shield,1,true);attacks(s,hit);end(s);check(s.hp==44-std::max(0,std::max(0,hit-1)+2*hit-1),"One-point first hit reduction precedes Shield; floor0");collect(s);const auto hp=s.hp;end(s);check(s.hp==hp-3*hit,"No renewal inside fight");}auto s=arena();acquire(s,"UGS-071");start(s);collect(s);s.enemies[0].mesh=2;shot(s);check(s.hp==42,"Recoil not enemy attack reduction");attacks(s,1);end(s);check(s.hp==40,"First later enemy hit still reduced");});
add("UGS-105","opening Weaken affects every attack hit then decays, including ordinary zero floor",[]{auto s=arena();acquire(s,"UGS-105");attacks(s,2,3);start(s);for(const auto& e:s.enemies)check(e.weaken==1,"Every living opening enemy weakened");collect(s);end(s);check(s.hp==31,"Three robots times three reduced hits");for(const auto& e:s.enemies)check(e.weaken==0,"Weaken decays after enemy turn");collect(s);end(s);check(s.hp==13,"Next turn unweakened");s=arena();acquire(s,"UGS-105");attacks(s,0,3);start(s);collect(s);end(s);check(s.hp==40,"Damage cannot become negative");});
add("MY2-03","capacity query adds four without copies and turn3 alone grants a fresh Pellet",[]{auto s=arena();acquire(s,"MY2-03");check(upgradeGeneralMemoryBonus(s)==4&&s.memory.empty(),"Four capacity only");start(s);collect(s);end(s);check(outputs(s,"MY2-03").empty(),"Not turn2");collect(s);end(s);auto ids=outputs(s,"MY2-03");check(ids.size()==1&&part(s,ids[0]).recipe=="SH003"&&part(s,ids[0]).createdRound==3&&part(s,ids[0]).origin==PartOrigin::Granted,"Fresh physical Pellet turn3 before haul");collect(s);fire(s,ids);check(s.enemies[0].hp==9997,"Ordinary3 damage");end(s);check(outputs(s,"MY2-03").empty(),"No turn4 repeat");s=arena();acquire(s,"MY2-03");start(s);collect(s);for(auto& e:s.enemies)e.intent=e.pattern[0]={Move::Escape,0,0};end(s);check(s.phase==Phase::Escaped&&outputs(s,"MY2-03").empty(),"Early terminal cancels unearned delivery");});
add("UGS-022","turn2 delivery precedes haul, does not recur and cannot appear after early escape",[]{auto s=arena();acquire(s,"UGS-022");start(s);check(s.materials==Materials({100,100,100,100,100}),"No opening extra");collect(s);const auto before=s.materials;end(s);check(delta(s.materials,before)==Materials({2,1,0,0,0}),"Turn2 prehaul delivery");collect(s);const auto held=s.materials;end(s);check(s.materials==held,"Not repeated on turn3");s=renewed(s);start(s);collect(s);for(auto& e:s.enemies)e.intent=e.pattern[0]={Move::Escape,0,0};const auto b=s.materials;end(s);check(s.phase==Phase::Escaped&&s.materials==b,"Escape has no next-start delivery");});
add("UGS-050","three-turn material cycle repeats before collection and resets with fight",[]{auto s=arena();acquire(s,"UGS-050");start(s);for(int turn=1;turn<=9;++turn){const auto b=s.materials;collect(s);check(delta(s.materials,b)==Materials({5,2,1,1,1}),"Normal haul unchanged");const auto held=s.materials;end(s);check(delta(s.materials,held)==((turn+1)%3==0?Materials({1,1,0,0,0}):Materials{}),"Only next turns divisible by3 grant before haul");}s=renewed(s);const auto b=s.materials;start(s);check(s.materials==b,"Cycle resets each entry");});
add("UGS-051","fifth-turn ordinary haul adds one steered unit with fight-local cadence",[]{auto s=arena();acquire(s,"UGS-051");start(s);for(int turn=1;turn<=10;++turn){const auto b=s.materials;collect(s,-1,4);check(delta(s.materials,b)==Materials({3,2,1,1,3+(turn%5==0?1:0)}),"Only ordinary haul5/10 receives extra steered unit");end(s);}s=renewed(s);start(s);const auto b=s.materials;collect(s,-1,4);check(delta(s.materials,b)==Materials({3,2,1,1,3}),"Entry restarts counter");});
add("UGS-053","turn2 Shield10 is freshly installed, removable unused, and not repeated",[]{auto s=arena();acquire(s,"UGS-053");start(s);collect(s);check(Rules::shield(s)==0,"No turn1 Shield");end(s);const auto ids=outputs(s,"UGS-053");check(ids.size()==1&&Rules::shield(s)==10&&part(s,ids[0]).createdRound==2,"Turn2 fresh installed10 before collection");collect(s);act(s,Action::remove(ids[0]));end(s);check(exists(s,ids[0])&&Rules::shield(s)==0&&outputs(s,"UGS-053").size()==1,"Unused saved part, no turn3 duplicate");});
add("UGS-094","every third start cools only greatest positive copy with stable memory-order tie",[]{auto s=arena();acquire(s,"UGS-094");const auto a=memory(s,"SH013"),b=memory(s,"SH013"),c=memory(s,"SH013");start(s);collect(s);next(s);copy(s,a).cooldown=5;copy(s,b).cooldown=5;copy(s,c).cooldown=4;end(s);check(copy(s,a).cooldown==3&&copy(s,b).cooldown==4&&copy(s,c).cooldown==3,"Ordinary decay first, then one greatest tied earliest copy");snapshot(s);collect(s);end(s);check(copy(s,a).cooldown==2&&copy(s,b).cooldown==3,"No turn4 upgrade cooling");collect(s);next(s);end(s);check(copy(s,a).cooldown==0&&copy(s,b).cooldown==0&&copy(s,c).cooldown==0,"Turn6 greatest cooled toready once");collect(s);next(s);next(s);end(s);check(copy(s,a).cooldown==0&&copy(s,b).cooldown==0,"Ready copies never negative at turn9");});
add("UGS-099","turn4/8 saved choices allow exactly Iron or Glass before haul and reset",[]{auto s=arena();acquire(s,"UGS-099");start(s);collect(s);for(int t=2;t<=9;++t){const auto before=s.materials;end(s);if(t%4==0){check(s.upgradeChoices.size()==1&&s.upgradeChoices[0].values==std::vector<Amount>({0,3}),"Exact fourth-turn choices");snapshot(s);Action bad;bad.type=ActionType::ResolveUpgradeChoice;bad.upgradeChoice.choice=s.upgradeChoices[0].id;bad.upgradeChoice.values={1};reject(s,bad);selectMaterial(s,t==4?0:3);check(s.materials[t==4?0u:3u]==before[t==4?0u:3u]+2,"Chosen2 before haul");}else check(s.upgradeChoices.empty()&&s.materials==before,"No other start grant");collect(s);}s=renewed(s);start(s);check(s.upgradeChoices.empty(),"Cycle reset");});
add("UGS-117","third-turn physical Shield and fight-lived first-shot bonus survive zero-shot turns",[]{auto s=arena();acquire(s,"UGS-117");start(s);collect(s);next(s);check(Rules::shield(s)==0,"No turn2 Shield");next(s);check(s.round==3&&Rules::shield(s)==4&&outputs(s,"UGS-117").size()==1,"Turn3 physical4");next(s);check(Rules::shield(s)==0,"Unused installed Shield cleans at turn3 end");next(s);check(shot(s)==10&&shot(s)==6,"First Fire after idle turns consumes4 once");next(s);check(outputs(s,"UGS-117").empty()&&shot(s)==6,"No periodic repeat");});
add("MY1-18","first two ordinary hauls add two to selected material without altering base or Precision",[]{for(Amount precision:{-1,0,1,2}){auto s=arena();acquire(s,"MY1-18");start(s);for(int turn=1;turn<=3;++turn){const auto b=s.materials;collect(s,turn==1?precision:-1,4);const auto extra=turn<=2?2:0;check(delta(s.materials,b)==Materials({3,2,1,1,3+extra+(turn==1?std::max(0,precision):0)}),"First two haul bonus separate from Precision payout");end(s);}s=renewed(s);start(s);const auto b=s.materials;collect(s,-1,0);check(s.materials[0]-b[0]==7,"Entry renews two opening hauls");}});
add("UGS-061","first haul only receives one steered extra, Auto does not consume Precision",[]{auto s=arena();acquire(s,"UGS-061");start(s);const auto b=s.materials;collect(s,-1,3);check(delta(s.materials,b)==Materials({3,2,1,4,1})&&!s.precisionSpent,"Opening Auto extra1 without attempt");next(s);const auto held=s.materials;end(s);collect(s,2,3);check(delta(s.materials,held)==Materials({3,2,1,5,1})&&s.precisionSpent,"Later manual payout independent, no extra opener");s=renewed(s);start(s);const auto reset=s.materials;collect(s,-1,3);check(s.materials[3]-reset[3]==4,"Renew entry");});
add("UGS-096","only first failed Precision grants one same-target bonus without retry or baseline loss",[]{for(Amount result:{-1,0,1,2}){auto s=arena();acquire(s,"UGS-096");start(s);const auto b=s.materials;collect(s,result,2);check(delta(s.materials,b)==Materials({3,2,3+std::max(0,result)+(result==0?1:0),1,1}),"Failure-only consolation, normal haul survives");check(s.upgradeChoices.empty()&&s.precisionSpent==(result>=0),"No retry and original attempt usage retained");if(result>=0){end(s);reject(s,Action::collect(2,0));collect(s,-1,2);}s=renewed(s);start(s);const auto reset=s.materials;collect(s,0,2);check(s.materials[2]-reset[2]==4,"Consolation renews next fight");}});
add("UGS-058","twenty-percent original Precision region widens symmetrically without payouts or attempts",[]{auto s=arena();acquire(s,"UGS-058");check(upgradePrecisionWidthPercent(s)==120,"Exactly20 percentage points of original width");foundry::presentation::PrecisionAttempt base,wide(upgradePrecisionWidthPercent(s));check(std::abs(wide.goodHalfWidth()-base.goodHalfWidth()*1.2)<1e-12&&std::abs(wide.perfectHalfWidth()-base.perfectHalfWidth()*1.2)<1e-12,"Both regions scaled from original");check(base.score(.315)==0&&wide.score(.315)==1&&wide.score(.685)==1&&wide.score(.5)==2,"Centered symmetric region");check(wide.score(-.01)==0&&wide.score(1.01)==0,"Track bounds");for(Amount result:{0,1,2}){auto f=renewed(s);start(f);const auto b=f.materials;collect(f,result,0);check(f.materials[0]-b[0]==5+result&&f.precisionSpent,"Same fixed payouts, one attempt");end(f);reject(f,Action::collect(0,2));}});
add("MY1-17","single saved same-target retry preserves spent original and cannot recurse",[]{for(Amount retry:{0,1,2}){auto s=arena();acquire(s,"MY1-17");start(s);const auto b=s.materials;collect(s,0,4);check(s.materials[4]-b[4]==3&&s.precisionSpent&&s.upgradeChoices.size()==1,"Baseline granted before one retry");snapshot(s);Action bad;bad.type=ActionType::ResolveUpgradeChoice;bad.upgradeChoice.choice=s.upgradeChoices[0].id;bad.upgradeChoice.values={3};reject(s,bad);selectMaterial(s,retry);check(s.materials[4]-b[4]==3+retry&&s.upgradeChoices.empty(),"Same target retry payout; failed retry does not recurse");end(s);reject(s,Action::collect(0,0));collect(s);check(s.upgradeChoices.empty(),"Original attempt remains spent");}auto s=arena();acquire(s,"MY1-17");start(s);collect(s,2);check(s.upgradeChoices.empty(),"Successful original never offers retry");});
add("UGS-042","first haul can exchange at most three base units one-for-one with saved atomic choices",[]{for(Amount amount:{0,1,3}){auto s=arena();acquire(s,"UGS-042");start(s);collect(s,2,0);check(s.upgradeChoices.size()==1&&s.upgradeChoices[0].baseHaul==Materials({3,2,1,1,1}),"Only base composition offered, excludes steering and Precision");snapshot(s);const auto b=s.materials;Action bad;bad.type=ActionType::ResolveUpgradeChoice;bad.upgradeChoice.choice=s.upgradeChoices[0].id;bad.upgradeChoice.removed={4,0,0,0,0};bad.upgradeChoice.added={0,0,0,0,4};reject(s,bad);bad.upgradeChoice.removed={1,0,0,0,0};bad.upgradeChoice.added={1,0,0,0,0};reject(s,bad);bad.upgradeChoice.added={0,2,0,0,0};reject(s,bad);UpgradeAnswer a;a.removed={amount,0,0,0,0};a.added={0,0,0,0,amount};answer(s,a);check(s.materials[0]==b[0]-amount&&s.materials[4]==b[4]+amount,"Exact unit exchange");next(s);check(s.upgradeChoices.empty(),"Only first haul");}});
