add("MY1-22","each opening choice grants exactly two ordinary fresh physical parts with normal lifetime",[]{auto s=arena();acquire(s,"MY1-22");for(const auto* choice:{"assault","defence"}){s=renewed(s);start(s);snapshot(s);UpgradeAnswer a;a.option=choice;answer(s,a);auto ids=outputs(s,"MY1-22");check(ids.size()==2&&ids[0]!=ids[1]&&s.memory.empty(),"Two distinct outputs without ownership");for(auto id:ids)check(part(s,id).origin==PartOrigin::Granted&&part(s,id).originalValue==4,"Canonical4 grant");collect(s);if(a.option=="assault"){next(s);fire(s,ids);check(s.enemies[0].hp==9992,"Both saved Ammo4 can Fire");}else{check(Rules::shield(s)==8,"Two installed Shield4");for(auto id:ids)act(s,Action::remove(id));next(s);for(auto id:ids)act(s,Action::install(id));check(Rules::shield(s)==8,"Each untouched Shield saved independently");end(s);check(outputs(s,"MY1-22").empty(),"Installed pair cleans normally");}}});
