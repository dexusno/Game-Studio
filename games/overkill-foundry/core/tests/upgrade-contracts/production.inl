add("category:modifier-spread","all six spreading Modifier paid Uses trigger once; lifecycle and exclusions remain distinct",[]{for(const auto* recipe:{"SH005","SH051","SH082","SH110","MA041","MA111"}){auto s=arena();acquire(s,"UGS-095");start(s);collect(s);const auto grantId=grant(s,recipe);check(Rules::shield(s)==0&&part(s,grantId).kind==Kind::Spread,"Grant is a physical spread, not a paid recipe trigger");use(s,"SH002");use(s,"SH038");use(s,"MA001");check(Rules::shield(s)==0,"Shield/Magnet/Utility paid Uses excluded");const auto before=s.materials;const auto made=use(s,recipe);check(made.size()==2&&Rules::shield(s)==7,"One spread plus one ordinary Shield7 from first paid Modifier");for(std::size_t k=0;k<5;++k)check(s.materials[k]==before[k]-fights.recipe(recipe)->cost[k],"Full actual crafting payment retained");check(part(s,made[0]).kind==Kind::Spread&&part(s,made[0]).place==Place::Reserve,"Category repair does not convert it to planning Modifier");use(s,"SH036");check(Rules::shield(s)==7,"Later planning Modifier cannot repeat first-category reward");next(s);use(s,recipe);check(Rules::shield(s)==0,"No per-turn replay; first use allowance is fight-scoped");}});
add("MY1-01","first Ammo output each turn alone receives two, saved physical bonus survives until Fire",[]{auto s=arena();acquire(s,"MY1-01");start(s);collect(s);const auto granted=grant(s,"SH001");use(s,"SH002");const auto first=use(s,"SH001").front(),second=use(s,"SH001").front();check(part(s,granted).upgradeDamage==0&&part(s,first).upgradeDamage==2&&part(s,second).upgradeDamage==0,"Grant and Shield do not consume Ammo production allowance");snapshot(s);next(s);const auto third=use(s,"SH001").front();check(part(s,third).upgradeDamage==2,"New turn renews");const auto hp=s.enemies[0].hp;fire(s,{first,second,third});check(hp-s.enemies[0].hp==22,"Saved modifiers belong to their distinct outputs");});
add("MY2-02","first Shield recipe output each turn gets three on its physical saved balance",[]{auto s=arena();acquire(s,"MY2-02");start(s);collect(s);const auto granted=grant(s,"SH002");use(s,"SH001");const auto first=use(s,"SH002").front(),second=use(s,"SH002").front();check(part(s,granted).upgradeShield==0&&part(s,first).upgradeShield==3&&part(s,second).upgradeShield==0,"Grant and Ammo are ineligible");next(s);act(s,Action::install(first));check(Rules::shield(s)==9,"Saved bonus3 on printed6");act(s,Action::remove(first));const auto third=use(s,"SH026").front();check(part(s,third).shield==7&&part(s,third).upgradeShield==3,"Auto-install first output gains physical3");act(s,Action::remove(third));act(s,Action::install(third));check(Rules::shield(s)==7,"Remove/reinstall cannot duplicate bonus");});
add("MY1-15","persistent typed pack choice selects only Ammo or Shield and renews first physical output per turn",[]{for(const auto* choice:{"assault","defence"}){auto s=arena();acquire(s,"MY1-15");snapshot(s);Action bad;bad.type=ActionType::ResolveUpgradeChoice;bad.upgradeChoice.choice=s.upgradeChoices[0].id;bad.upgradeChoice.option="both";reject(s,bad);UpgradeAnswer a;a.option=choice;answer(s,a);start(s);collect(s);const auto ammo=use(s,"SH001").front(),shield=use(s,"SH002").front();check(part(s,ammo).upgradeDamage==(a.option=="assault"?2:0)&&part(s,shield).upgradeShield==(a.option=="defence"?3:0),"Only chosen class");const auto ammo2=use(s,"SH001").front(),shield2=use(s,"SH002").front();check(part(s,ammo2).upgradeDamage==0&&part(s,shield2).upgradeShield==0,"First only");next(s);const auto renewedOutput=use(s,a.option=="assault"?"SH001":"SH002").front();check(part(s,renewedOutput).upgradeDamage+part(s,renewedOutput).upgradeShield==(a.option=="assault"?2:3),"Per-turn renewed on new physical object");}});
