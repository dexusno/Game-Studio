void edgeCases(){
add("edge:bond-reward","UGS085 still grants one100Credits when actually accepted as a nonpurchase Officer reward",[]{auto c=campaign();bool found=false;for(int n=0;n<10&&!found;++n){enterAvailable(c,true);const auto officer=c.fight.encounterClass==EncounterClass::Officer;finish(c);if(officer){auto& offer=reward(c,RewardKind::Upgrade);offer.choices={"UGS-085","UGS-001","UGS-002"};const auto id=offer.id;const auto before=c.fight.credits;const auto action=command(c,CampaignActionType::ClaimReward,id,"UGS-085");run(c,action);check(c.fight.credits==before+100&&ownedUpgrade(c.fight,"UGS-085"),"No shop gate applied to real reward acquisition");const auto saved=serializeCampaign(c);check(campaigns.apply(c,action).replayed&&serializeCampaign(c)==saved,"Reward receipt cannot grant100again");found=true;}leave(c);}check(found,"Real Officer result reached");});
add("edge:reward-origin","UGS040/041/134 exclude copied and Shop acquisitions; non-Shield acceptance leaves Shield opportunity",[]{auto c=campaign();for(const auto* id:{"UGS-040","UGS-041","UGS-134","UGS-101","UGS-032"})buy(c,ProductKind::Upgrade,id);Id source=0;for(const auto& item:c.fight.memory)if(item.recipe=="SH002")source=item.id;auto duplicate=command(c,CampaignActionType::ResolveUpgradeOffer,c.upgradeOffers[0].id);duplicate.target=source;run(c,duplicate);check(c.fight.memory.back().recipe=="SH002"&&c.fight.memory.back().tags.empty(),"Generated copied Shield creates neither reinforcement nor Iron coupon");buy(c,ProductKind::Recipe,"SH007");check(c.fight.memory.back().tags.empty(),"Shop Utility does not receive Copper coupon");enter(c);finish(c);controlledRecipes(c,{"SH007","SH001","SH003"});const auto utility=acceptRecipe(c,"SH007");controlledRecipes(c,{"SH002","SH001","SH003"});const auto shield=acceptRecipe(c,"SH002");check(copy(c.fight,utility).tags.size()==1&&copy(c.fight,utility).tags[0].kind==RecipeTagKind::CopperCoupon,"Actual Utility reward gets one specific coupon");check(copy(c.fight,shield).tags.size()==2&&std::any_of(copy(c.fight,shield).tags.begin(),copy(c.fight,shield).tags.end(),[](const RecipeTag& t){return t.kind==RecipeTagKind::Shield&&t.amount==2;}),"Earlier non-Shield acceptance leaves first Shield reinforcement intact");});
add("edge:normal-rarity","UGS031 fourth option uses current normal weighted pool, Shared-only duplicate filtering",[]{for(std::uint64_t seed=1;seed<=24;++seed){auto c=campaign("MY1-02",seed);buy(c,ProductKind::Upgrade,"UGS-031");enter(c);const auto* selected=selectedRouteOffer(c.route);check(selected!=nullptr,"Committed route identity");auto normalRng=Rng::seeded(selected->encounterSeed,selected->encounterKey+"/normal-victory-recipes");const auto expectedNormal=drawCityOffer(campaigns.content().recipes,campaigns.content().recipePools,"Regular",normalRng,Domain::Reward,3);auto fourthRng=c.rng;const auto fourth=drawCityOffer(campaigns.content().recipes,campaigns.content().recipePools,"Regular",fourthRng,Domain::Choice,1,expectedNormal,[](const std::string& id){return id.substr(0,2)=="SH";});finish(c);const auto choices=reward(c).choices;check(choices.size()==4&&std::equal(expectedNormal.begin(),expectedNormal.end(),choices.begin()),"Normal first3 untouched");check(fourth.size()==1&&choices.back()==fourth[0],"Fourth matches normal reward odds with Shared filter, not first card's rarity");check(std::set<std::string>(choices.begin(),choices.end()).size()==4,"Duplicate normal cards excluded");}});
add("edge:paid-output","zero-resource recipe Use is eligible for unconditional Mayor but excluded from paid-only Jig",[]{for(const auto* id:{"MY1-01","UGS-121"}){bool found=false;for(std::uint64_t seed=1;seed<=32&&!found;++seed){auto s=arena();s.rng=Rng::seeded(seed,"zero-cost");acquire(s,id);acquire(s,"UGS-116");start(s);if(ownedUpgrade(s,"UGS-116")->values[0]!=0)continue;found=true;collect(s);s.materials[0]=0;const auto free=use(s,"SH001").front();check(s.materials[0]==0&&part(s,free).upgradeDamage==(std::string(id)=="MY1-01"?2:0),"Actual fully discounted Use follows source paid/unconditional distinction");s.materials[0]=1;const auto paid=use(s,"SH001").front();check(s.materials[0]==0&&part(s,paid).upgradeDamage==(std::string(id)=="UGS-121"?2:0),"Free Jig output does not consume first paid production trigger");}check(found,"Deterministic Iron discount witness");}});
add("edge:entry-setup","UGS037 uses actual Warden factory opening tiles and no Fire count",[]{auto s=arena();s.enemies=makeCinderwallFormation("C1-F-WARDEN",1,"opening-warden",s.nextId);const auto before=s.enemies[0];check(before.tiles>0,"Source Warden starts with tiles");acquire(s,"UGS-037");start(s,EncounterClass::Officer);check(s.enemies[0].tiles==before.tiles-1&&s.enemies[0].hp==before.hp-1&&s.shots==0,"Opening setup defense applies before non-Fire flare");});
add("edge:late-officer","Officer achievements before acquisition never become UGS045 levels or UGS125 awakening",[]{for(const auto* id:{"UGS-045","UGS-125"}){auto c=campaign();bool bought=false;Amount laterWins=0;for(int n=0;n<12;++n){enterAvailable(c,true);const auto kind=c.fight.encounterClass;if(bought&&id==std::string("UGS-125"))check(c.fight.shotBonuses.empty(),"Only two postacquisition Officers remain; never awakens");finish(c);if(kind==EncounterClass::Officer){if(!bought){buy(c,ProductKind::Upgrade,id);bought=true;check(ownedUpgrade(c.fight,id)->campaignCount==0&&upgradeCounter(*ownedUpgrade(c.fight,id),"officers")==0,"Prior Officer excluded at actual paid acquisition");}else ++laterWins;}leave(c);}check(bought&&laterWins==2,"One prior and two subsequent real Officers");if(id==std::string("UGS-045"))check(ownedUpgrade(c.fight,id)->campaignCount==2,"Only two later training levels");else check(upgradeCounter(*ownedUpgrade(c.fight,id),"awakened")==0,"No retroactive awakening");}});
add("edge:credit-origin","UGS017 never multiplies direct acquisition Credits and UGS085 nonpurchase grant remains valid",[]{auto c=campaign();buy(c,ProductKind::Upgrade,"UGS-017");c.fight.credits=10000;const auto before=c.fight.credits;buy(c,ProductKind::Upgrade,"UGS-085",101);check(c.fight.credits==before-1,"Pay101 then direct100, no quarter multiplier");auto s=arena();const auto credits=s.credits;acquire(s,"UGS-085");check(s.credits==credits+100,"Nonpurchase acquisition still grants100 without a shop-price context");});
add("edge:unused-lease","UGS015 consumes each entry even without Ammo use and cannot defer its three-fight lease",[]{auto s=arena();acquire(s,"UGS-015");for(int entry=1;entry<=4;++entry){if(entry>1)s=renewed(s);start(s);collect(s);if(entry==2||entry==4)check(use(s,"SH001").size()==(entry==2?2u:1u),"Unused fight licenses cannot be banked");check(ownedUpgrade(s,"UGS-015")->charges==std::max(0,3-entry),"One charge consumed at each of first3entries");}});
add("edge:calibration-eligibility","UGS039 missing either required stored type rejects before HP payment or ledger insertion",[]{for(const auto* available:{"SH001","SH002"}){auto s=arena();memory(s,available);const auto before=serialize(s);const auto result=fights.acquireUpgrade(s,"UGS-039");check(!result.ok&&result.events.empty()&&serialize(s)==before,"Both one Ammo and one Shield required atomically");}});
