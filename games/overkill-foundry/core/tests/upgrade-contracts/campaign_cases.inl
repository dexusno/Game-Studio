add("UGS-041","new victory Utility Copper coupon applies once each fight only to that copy and full other cost",[]{auto c=campaign();buy(c,ProductKind::Upgrade,"UGS-041");const auto old=memory(c.fight,"SH007");enter(c);finish(c);controlledRecipes(c,{"SH007","SH001","SH003"});const auto selected=acceptRecipe(c,"SH007");check(copy(c.fight,old).tags.empty()&&copy(c.fight,selected).tags.size()==1,"Preexisting identical copy excluded");leave(c);for(int fight=0;fight<2;++fight){enter(c);combat(c,Action::collect(0));c.fight.materials={20,20,20,20,20};const auto before=c.fight.materials;craft(c.fight,selected);check(c.fight.materials[1]==before[1]&&c.fight.materials[3]==before[3]-1,"One Copper saved, full Glass paid");next(c.fight);const auto again=c.fight.materials;craft(c.fight,selected);check(c.fight.materials[1]==again[1]-1,"No per-turn renewal");finish(c);leave(c);}});
