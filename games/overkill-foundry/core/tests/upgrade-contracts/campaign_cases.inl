void campaignCases(){
add("UGS-002","production victory with kills pays8 once; all-escape and final defeat never pay",[]{for(int outcome=0;outcome<3;++outcome){auto c=campaign();buy(c,ProductKind::Upgrade,"UGS-002");enter(c);const auto credits=c.fight.credits;finish(c,outcome==1,outcome==2);check(c.fight.credits==credits+(outcome==0?8:0),"Kill-victory only direct8Credits");if(outcome==0){snapshot(c);run(c,command(c,CampaignActionType::OpenRecipes,reward(c).id));run(c,command(c,CampaignActionType::BackRecipes));check(c.fight.credits==credits+8,"Reward navigation does not redispatch victory");}}});
add("UGS-017","each core sale rounds quarter independently, ordinary parts and direct Credits excluded",[]{auto c=campaign();buy(c,ProductKind::Upgrade,"UGS-017");enter(c);finish(c);auto& cores=reward(c,RewardKind::Cores);run(c,command(c,CampaignActionType::ClaimReward,cores.id));const auto real=c.cores;check(!real.empty(),"Real destroyed robot cores claimed");for(const auto& core:real){const auto before=c.fight.credits;const auto a=command(c,CampaignActionType::SellCore,core.id);run(c,a);check(c.fight.credits-before==core.baseValue+core.baseValue/4,"Individual core sale uses floor(base/4)");const auto bytes=serializeCampaign(c);const auto replay=campaigns.apply(c,a);check(replay.ok&&replay.replayed&&serializeCampaign(c)==bytes,"Sale receipt does not repeat payment");}for(Amount value:{1,3,4,7,8,11}){const auto id=c.nextId++;c.cores.push_back({id,"C1-R01",value});const auto before=c.fight.credits;run(c,command(c,CampaignActionType::SellCore,id));check(c.fight.credits-before==value+value/4,"Controlled integer boundary per core, never batch-round");}leave(c);enter(c);combat(c,Action::collect(0));const auto id=grant(c.fight,"SH001");const auto before=c.fight.credits;run(c,command(c,CampaignActionType::SellPart,id));check(c.fight.credits-before==2,"Ordinary Slug sale gets base2 only, no core bonus");});
add("MY1-16","first ordinary part sale per fight matches canonical base capped12, sold id and receipt consumed",[]{auto c=campaign("MY1-16");enter(c);combat(c,Action::collect(0));for(int sale=0;sale<2;++sale){const auto id=grant(c.fight,"SH109");const auto base=(part(c.fight,id).recipe=="SH109"?13:2);const auto before=c.fight.credits;auto a=command(c,CampaignActionType::SellPart,id);run(c,a);check(c.fight.credits-before==base+(sale==0?std::min(12,base):0),"Only first sale doubles base up to12");check(!exists(c.fight,id),"Exact sold part removed");const auto saved=serializeCampaign(c);check(campaigns.apply(c,a).replayed&&serializeCampaign(c)==saved,"Receipt does not resell");}finish(c);leave(c);enter(c);combat(c,Action::collect(0));const auto id=grant(c.fight,"SH001");const auto base=(part(c.fight,id).recipe=="SH109"?13:2);const auto before=c.fight.credits;run(c,command(c,CampaignActionType::SellPart,id));check(c.fight.credits-before==base*2,"New fight resets match, small base not forced to12");});
add("UGS-033","victory entitlements accumulate until first following core sale and exclude part sales",[]{auto c=campaign();buy(c,ProductKind::Upgrade,"UGS-033");c.fight.hp=40;for(int i=0;i<2;++i){enter(c);finish(c);run(c,command(c,CampaignActionType::ClaimReward,reward(c,RewardKind::Cores).id));leave(c);}snapshot(c);const auto max=c.fight.maxHp,hp=c.fight.hp;enter(c);combat(c,Action::collect(0));const auto id=grant(c.fight,"SH001");run(c,command(c,CampaignActionType::SellPart,id));check(c.fight.maxHp==max&&c.fight.hp==hp,"Part sale never redeems core entitlements");const auto core=c.cores.front().id;run(c,command(c,CampaignActionType::SellCore,core));check(c.fight.maxHp==max+2&&c.fight.hp==hp+2,"Two skipped victories redeem together once");run(c,command(c,CampaignActionType::SellCore,c.cores.front().id));check(c.fight.maxHp==max+2,"Further core sale cannot repeat redeemed entitlements");});
add("UGS-065","next true victory heals10 once, escape does not spend, final death cannot rescue",[]{auto c=campaign();buy(c,ProductKind::Upgrade,"UGS-065");c.fight.hp=40;enter(c);finish(c,true);check(c.fight.hp==40&&ownedUpgrade(c.fight,"UGS-065")->charges==1,"All-escaped fight leaves charge");leave(c);enter(c);const auto hp=c.fight.hp;finish(c);check(c.fight.hp==hp+10&&ownedUpgrade(c.fight,"UGS-065")->charges==0,"First won fight spends and heals10");leave(c);enter(c);c.fight.hp=40;finish(c);check(c.fight.hp==40,"Spent upgrade remains owned but pays no second heal");auto dead=campaign();buy(dead,ProductKind::Upgrade,"UGS-065");enter(dead);finish(dead,false,true);check(dead.fight.hp==0&&ownedUpgrade(dead.fight,"UGS-065")->charges==1,"Final defeat gets neither heal nor victory charge consumption");});
add("UGS-129","every real victory grows and heals one, all escape and death do not, receipt navigation is inert",[]{auto c=campaign();buy(c,ProductKind::Upgrade,"UGS-129");const auto original=c.fight.maxHp;c.fight.hp=40;enter(c);finish(c,true);check(c.fight.maxHp==original&&c.fight.hp==40,"All escape no growth");leave(c);for(int i=1;i<=2;++i){enter(c);finish(c);check(c.fight.maxHp==original+i&&c.fight.hp==40+i,"One growth and heal each real victory");snapshot(c);leave(c);}auto dead=campaign();buy(dead,ProductKind::Upgrade,"UGS-129");const auto max=dead.fight.maxHp;enter(dead);finish(dead,false,true);check(dead.fight.maxHp==max&&dead.fight.hp==0,"Death receives no growth or revive");});
add("UGS-142","failed-Precision victory alone earns one consumed next-entry Iron, misses never stack",[]{for(int outcome=0;outcome<4;++outcome){auto c=campaign();buy(c,ProductKind::Upgrade,"UGS-142");enter(c);combat(c,Action::collect(0,outcome==0?-1:outcome==1?2:0));finish(c,outcome==3);leave(c);enter(c);check(c.fight.materials[0]==(outcome==2?1:0),"Voucher only from failed Precision plus actual victory, not Auto/success/escape");finish(c);leave(c);enter(c);check(c.fight.materials[0]==0,"Consumed voucher cannot persist without a new failed victory");}auto c=campaign("MY1-17");buy(c,ProductKind::Upgrade,"UGS-142");enter(c);combat(c,Action::collect(0,0));auto a=command(c,CampaignActionType::ResolveUpgradeChoice);a.combat.type=ActionType::ResolveUpgradeChoice;a.combat.upgradeChoice.choice=c.fight.upgradeChoices[0].id;a.combat.upgradeChoice.values={0};run(c,a);finish(c);leave(c);enter(c);check(c.fight.materials[0]==1,"Original plus failed retry still makes one voucher");});
add("UGS-085","one acquisition100Credits and its own strict undiscounted purchase-price gate",[]{for(Amount price:{0,99,100}){auto low=campaign();low.fight.credits=1000;const auto id=low.nextId++;low.shop.push_back({id,ProductKind::Upgrade,"UGS-085",0,1,price});reject(low,command(low,CampaignActionType::Buy,id));}auto c=campaign();c.fight.credits=1000;const auto product=c.nextId++;c.shop.push_back({product,ProductKind::Upgrade,"UGS-085",0,1,101});const auto a=command(c,CampaignActionType::Buy,product);run(c,a);check(c.fight.credits==999,"Actual101 purchase then one100 acquisition credit");const auto saved=serializeCampaign(c);check(campaigns.apply(c,a).replayed&&serializeCampaign(c)==saved,"Replay cannot mint100again");buy(c,ProductKind::Recipe,"SH001",30);check(copy(c.fight,c.fight.memory.back().id).recipe=="SH001","Upgrade does not ban other cheap purchases");auto discounted=campaign();buy(discounted,ProductKind::Upgrade,"UGS-075");const auto id=discounted.nextId++;discounted.shop.push_back({id,ProductKind::Upgrade,"UGS-085",0,1,110});check(upgradeShopPrice(discounted.fight,PurchaseKind::Upgrade,110)==88,"Existing discount lowers final110 price to88");const auto money=discounted.fight.credits;run(discounted,command(discounted,CampaignActionType::Buy,id));check(discounted.fight.credits==money-88+100,"Gate uses undiscounted own110; paid88 and acquired100 once");});
add("MY1-14","one saved full normal-offer reroll per victory, repeat rejected, old discoveries retained",[]{auto c=campaign("MY1-14");enter(c);finish(c);const auto id=reward(c).id;run(c,command(c,CampaignActionType::OpenRecipes,id));const auto old=reward(c).choices;auto before=c;snapshot(c);const auto reroll=command(c,CampaignActionType::RerollRecipeReward,id);run(c,reroll);auto resumed=before;run(resumed,reroll);check(serializeCampaign(c)==serializeCampaign(resumed),"Saved RNG reroll deterministic");check(reward(c).choices.size()==old.size(),"Entire offer same candidate count");for(const auto& value:old)check(std::find(c.profile.recipes.begin(),c.profile.recipes.end(),value)!=c.profile.recipes.end(),"Old revealed collection knowledge remains");reject(c,command(c,CampaignActionType::RerollRecipeReward,id));leave(c);enter(c);finish(c);const auto nextId=reward(c).id;run(c,command(c,CampaignActionType::OpenRecipes,nextId));run(c,command(c,CampaignActionType::RerollRecipeReward,nextId));check(upgradeCounter(*ownedUpgrade(c.fight,"MY1-14"),"reward_reroll")==1,"Next victory renews exactly one reroll");});
add("UGS-012","first victory recipe optionally duplicates exact copy with saved exchange, no recursive acceptance",[]{auto c=campaign();buy(c,ProductKind::Upgrade,"UGS-012");buy(c,ProductKind::Upgrade,"UGS-101");enter(c);finish(c);controlledRecipes(c,{"SH001","SH002","SH003"});const auto source=acceptRecipe(c,"SH001");check(source&&c.upgradeOffers.size()==1&&c.upgradeOffers[0].sourceCopy==source,"Optional duplicate is tied to actual first accepted physical copy");c.memorySlots=static_cast<Amount>(c.fight.memory.size());const auto offer=c.upgradeOffers[0].id;auto pending=command(c,CampaignActionType::ResolveUpgradeOffer,offer);run(c,pending);check(!c.upgradeOffers[0].selected.empty(),"Full memory pauses exact copy exchange");snapshot(c);auto commit=command(c,CampaignActionType::ResolveUpgradeOffer,offer);commit.exchange=c.fight.memory[0].id;const auto n=c.fight.memory.size();run(c,commit);check(c.fight.memory.size()==n&&c.fight.memory.back().recipe=="SH001"&&c.fight.memory.back().id!=source&&c.upgradeOffers.empty(),"Exact additional independent copy, no recursive duplicate");controlledRecipes(c,{"SH002","SH003","SH001"});acceptRecipe(c,"SH002",c.fight.memory[1].id);check(c.upgradeOffers.empty(),"Second normal offer same victory not another entitlement");leave(c);enter(c);finish(c);const auto id=reward(c).choices.front();acceptRecipe(c,id,c.fight.memory[0].id);check(c.upgradeOffers.size()==1,"Next victory renews");auto decline=command(c,CampaignActionType::ResolveUpgradeOffer,c.upgradeOffers[0].id);decline.decline=true;const auto count=c.fight.memory.size();run(c,decline);check(c.fight.memory.size()==count&&c.upgradeOffers.empty(),"Optional decline creates no copy");});
add("UGS-016","fifth actual victory acceptance heals8 across fights; shops/generated and repeat navigation excluded",[]{auto c=campaign();buy(c,ProductKind::Upgrade,"UGS-016");buy(c,ProductKind::Upgrade,"UGS-012");c.memorySlots=40;c.fight.hp=40;buy(c,ProductKind::Recipe,"SH001");check(upgradeCounter(*ownedUpgrade(c.fight,"UGS-016"),"acceptances")==0,"Shop excluded");for(int n=1;n<=5;++n){enter(c);finish(c);const auto hp=c.fight.hp;const auto selected=reward(c).choices.front();acceptRecipe(c,selected);check(c.fight.hp==hp+(n==5?8:0),"Only fifth actual acceptance heals8");const auto copied=command(c,CampaignActionType::ResolveUpgradeOffer,c.upgradeOffers[0].id);run(c,copied);check(upgradeCounter(*ownedUpgrade(c.fight,"UGS-016"),"acceptances")==n,"Generated Carbonpaper copy excluded");if(n==4)controlledCityBoundary(c);snapshot(c);leave(c);}check(c.fight.hp==48,"One fifth-acceptance heal only");});
