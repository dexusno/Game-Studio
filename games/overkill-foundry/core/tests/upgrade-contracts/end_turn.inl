void endTurnCases(){
add("MY1-19","raw total threshold schedules one Ammo5 next start without spending and cancels on terminal",[]{for(Amount totalMaterials:{0,2,3,20}){auto s=arena();acquire(s,"MY1-19");start(s);collect(s);s.materials={0,0,0,totalMaterials,0};const auto before=s.materials;end(s);auto ids=outputs(s,"MY1-19");check(ids.size()==(totalMaterials>=3?1u:0u)&&s.materials==before,"Threshold uses all raw types without spending");if(totalMaterials>=3){check(part(s,ids[0]).originalValue==5&&part(s,ids[0]).place==Place::Reserve&&part(s,ids[0]).createdRound==2,"Fresh delayed Ammo5");collect(s);fire(s,ids);check(s.enemies[0].hp==9995,"Ordinary physical payload");end(s);check(outputs(s,"MY1-19").size()==1,"One further grant per qualifying EndTurn");}}auto s=arena();acquire(s,"MY1-19");start(s);collect(s);for(auto& e:s.enemies)e.intent=e.pattern[0]={Move::Escape,0,0};end(s);check(s.phase==Phase::Escaped&&outputs(s,"MY1-19").empty(),"Terminal fight never delivers scheduled part");});
add("UGS-004","first EndTurn absence of installed Shield is structural, excludes later ends and respects empty parts",[]{for(int state=0;state<4;++state){auto s=arena();acquire(s,"UGS-004");start(s);collect(s);if(state==1)plain(s,Kind::Shield,2,true);if(state==2){const auto id=plain(s,Kind::Shield,2,true);part(s,id).shield=0;}if(state==3)plain(s,Kind::Shield,2,false);attacks(s,2);const auto hp=s.hp;auto r=end(s);check(eventAmount(r,"part_created","UGS-004")==((state==0||state==3)?4:0),"Installed zero-balance part still excludes grant; reserve does not");check(s.hp==hp-6+(state==1?2:(state==0||state==3?4:0)),"Grant protects current enemy phase");collect(s);r=end(s);check(eventAmount(r,"part_created","UGS-004")==0,"First EndTurn consumed even if blocked");}});
add("UGS-005","zero Fire delays two Iron one Carbon to next start regardless of crafting; Fire excludes",[]{for(bool fired:{false,true}){auto s=arena();acquire(s,"UGS-005");start(s);collect(s);if(fired)shot(s);else use(s,"SH001");const auto b=s.materials;const auto r=end(s);check(delta(s.materials,b)==(fired?Materials{}:Materials({2,0,1,0,0})),"Crafting is not Fire and delivery is next start");check(eventAmount(r,"part_created","UGS-005")==0,"Materials are not parts");collect(s);const auto before=s.materials;end(s);check(delta(s.materials,before)==Materials({2,0,1,0,0}),"Zero-shot turn renews");}auto s=arena();acquire(s,"UGS-005");start(s);collect(s);for(auto& e:s.enemies)e.intent=e.pattern[0]={Move::Escape,0,0};const auto b=s.materials;end(s);check(s.materials==b,"No next-turn delivery after escape");});
add("UGS-010","empty ordinary reserve grants five before enemies, installed parts excluded, renewal each turn",[]{for(int state=0;state<3;++state){auto s=arena();acquire(s,"UGS-010");start(s);collect(s);if(state==1)plain(s,Kind::Ammo,1);if(state==2)plain(s,Kind::Shield,1,true);attacks(s,2);const auto r=end(s);check(eventAmount(r,"part_created","UGS-010")==((state==1)?0:5),"Only ordinary reserve blocks");check(s.hp==40-6+(state==1?0:5)+(state==2?1:0),"Immediate enemy protection");collect(s);if(state==1){auto ids=outputs(s,"controlled-upgrade-fixture");fire(s,ids);}check(eventAmount(end(s),"part_created","UGS-010")==5,"Renews after reserve consumed");}});
add("UGS-028","ordinary reserve count grants one capped balance, installed parts excluded and no consumption",[]{for(Amount n:{0,1,6,7,9}){auto s=arena();acquire(s,"UGS-028");start(s);collect(s);for(Amount i=0;i<n;++i)plain(s,Kind::Ammo,1);plain(s,Kind::Shield,2,true);const auto r=end(s);check(eventAmount(r,"part_created","UGS-028")==std::min(7,n),"Reserve count cap7, installed part excluded");check(outputs(s,"controlled-upgrade-fixture").size()==static_cast<std::size_t>(n),"Counting consumes no reserve parts; installed cleans normally");collect(s);check(eventAmount(end(s),"part_created","UGS-028")==std::min(7,n),"Renews exactly once per end");}});
add("UGS-047","only first two EndTurns create three physical Shield before enemy attacks",[]{auto s=arena();acquire(s,"UGS-047");attacks(s,1);start(s);collect(s);for(int turn=1;turn<=3;++turn){const auto hp=s.hp;const auto r=end(s);check(eventAmount(r,"part_created","UGS-047")==((turn<=2)?3:0),"Only two opening turns");check(s.hp==hp-(turn<=2?0:3)&&Rules::shield(s)==0,"Enemy hits and reset consume physical3");collect(s);}s=renewed(s);start(s);collect(s);check(eventAmount(end(s),"part_created","UGS-047")==3,"New fight renews");});
add("UGS-086","zero combined Shield includes active balances, empty printed parts qualify and no recursive trigger",[]{for(int state=0;state<4;++state){auto s=arena();acquire(s,"UGS-086");start(s);collect(s);if(state==1)plain(s,Kind::Shield,1,true);if(state==2)s.protection.push_back({s.nextId++,s.nextOrder++,1});if(state==3){const auto id=plain(s,Kind::Shield,1,true);part(s,id).shield=0;}attacks(s,1);const auto r=end(s);check(eventAmount(r,"part_created","UGS-086")==((state==0||state==3)?5:0),"Total balance condition, not printed Shield existence");check(outputs(s,"UGS-086").empty()&&Rules::shield(s)==0,"Installed grant expires normally");collect(s);check(eventAmount(end(s),"part_created","UGS-086")==5,"Next end may trigger once again");}});
add("UGS-087","conjunction requires zero Fire and zero combined Shield at EndTurn",[]{for(int fired=0;fired<2;++fired)for(int shield=0;shield<2;++shield){auto s=arena();acquire(s,"UGS-087");start(s);collect(s);if(fired)shot(s);if(shield)s.protection.push_back({s.nextId++,s.nextOrder++,1});attacks(s,1);const auto r=end(s);check(eventAmount(r,"part_created","UGS-087")==((!fired&&!shield)?4:0),"Both requirements must hold");collect(s);check(eventAmount(end(s),"part_created","UGS-087")==4,"New round renews shot condition after Shield reset");}});
add("UGS-109","zero Fire grants four even with existing Shield; crafting/loading are not Fire",[]{for(int action=0;action<4;++action){auto s=arena();acquire(s,"UGS-109");start(s);collect(s);plain(s,Kind::Shield,1,true);if(action==1)use(s,"SH001");if(action==2)act(s,Action::load(use(s,"SH001")));if(action==3)shot(s);const auto r=end(s);check(eventAmount(r,"part_created","UGS-109")==((action==3)?0:4),"Only actual Fire excludes; Shield does not");collect(s);check(eventAmount(end(s),"part_created","UGS-109")==4,"Renewed next turn");}});
add("UGS-091","Shield10 reader does not spend and hits lowest current HP with stable tie before attacks",[]{for(Amount shield:{9,10,16}){auto s=arena();acquire(s,"UGS-091");start(s);collect(s);plain(s,Kind::Shield,shield,true);s.enemies[0].hp=20;s.enemies[1].hp=10;s.enemies[2].hp=10;attacks(s,4);auto r=end(s);check(s.enemies[1].hp==(shield>=10?5:10)&&s.enemies[0].hp==20&&s.enemies[2].hp==10,"Lowest currentHP tie first eligible slot, threshold10");check(s.hp==40-std::max(0,12-shield),"Reader leaves all Shield for enemy hits");check(eventAmount(r,"player_damage")==std::max(0,12-shield),"No hidden Shield payment");}auto s=arena();acquire(s,"UGS-091");start(s);collect(s);plain(s,Kind::Shield,10,true);s.enemies[0].hp=5;s.enemies[0].intent=s.enemies[0].pattern[0]={Move::Attack,100,1};end(s);check(s.enemies[0].dead&&s.hp==40,"Reader kill precedes that robot action");});
}
